# CandleForge 环境变量模板
# 复制为 .env 后按需修改（.env 已被 .gitignore 忽略，不会提交）

# ── PostgreSQL ──
DB_HOST=postgres
DB_PORT=5432
DB_USER=candleforge
DB_PASSWORD=candleforge
DB_NAME=candleforge

# ── Go 主服务 ──
HTTP_ADDR=:8080
# Python 回测服务 gRPC 地址（compose 内用服务名 quant-py）
QUANT_ADDR=quant-py:50051

# ── Python 回测服务 ──
GRPC_ADDR=[::]:50051

# ── 前端 ──
# 前端访问后端的基址（浏览器侧，故用 localhost）
VITE_API_BASE=http://localhost:8080
# 前端鉴权 token（与后端 AUTH_TOKEN 同值）；留空 = 不鉴权（本地开发）。
#   配了 AUTH_TOKEN 后必须同步设置此项，否则前端 REST 全 401、WS 被拒。
VITE_AUTH_TOKEN=

# ── Binance API（M4 实盘才需要，先留空）──
# 配置 key/secret 即激活实盘交易；默认走 testnet (testnet.binance.vision)。
# testnet API key 从 https://testnet.binance.vision 申请；mainnet 需要二次确认。
BINANCE_API_KEY=
BINANCE_API_SECRET=

# 启用主网（真金白银）— 默认 false 走 testnet。
BINANCE_MAINNET=false
# 启用主网必须填这个字面量；任何其他值都会阻止启动。
BINANCE_MAINNET_CONFIRM=

# 可选：覆盖默认 endpoint（用镜像/proxy 时设置）。
# BINANCE_REST_BASE=
# BINANCE_WS_BASE=

# ── Binance USDT-M 永续（M6.5 合约网格实盘才需要，先留空）──
# 注意：合约 testnet (testnet.binancefuture.com) 与现货 testnet 是两套独立账号/密钥。
# 主网复用上面的 BINANCE_MAINNET + BINANCE_MAINNET_CONFIRM 双开关。
BINANCE_FUTURES_API_KEY=
BINANCE_FUTURES_API_SECRET=

# ── 策略引擎 ──
# 并行运行策略数上限（默认 5）
# MAX_RUNNING_STRATEGIES=5

# ── 风控 / 撮合（E2/E3）──
# 单笔下单名义价值上限 USDT（默认 50000）；超限拒单。
# RISK_MAX_NOTIONAL=50000
# 模拟盘手续费率（默认 0.001 = 0.1%）；与回测 commission 对齐口径。
# SIM_COMMISSION=0.001

# ── 安全（WP2）──
# 静态 API Token：设置后所有 /api 接口与 /ws 都需鉴权（实盘前必须配置）。
#   HTTP 头 Authorization: Bearer <token> 或 X-Auth-Token: <token>；
#   WebSocket 用查询参数 ?token=<token>（浏览器无法自定义握手头）。
#   留空 = 无鉴权（仅本地开发）。
AUTH_TOKEN=
# CORS 白名单（逗号分隔的完整来源）；留空 = 反射任意来源（仅本地开发）。
#   配置 AUTH_TOKEN 时应同时收紧，例如：
#   CORS_ORIGINS=http://localhost:5173,https://app.example.com
CORS_ORIGINS=
# 子账户 API 密钥加密主密钥：32 字节，填 64 位 hex 或 base64。
#   生成：openssl rand -hex 32
#   留空 = 明文落库（仅本地开发）。设置后旧明文记录仍可读（灰度迁移）。
CREDENTIAL_ENC_KEY=

# ── 网络代理（容器到 Binance 不通时使用）──
# 例如本地 Clash/V2Ray：HTTPS_PROXY=http://host.docker.internal:7890
# HTTPS_PROXY=
# HTTP_PROXY=

# ── 可选：构建期镜像源（网络受限时取消注释，加速容器内拉依赖）──
# NPM_REGISTRY=https://registry.npmmirror.com
# GOPROXY=https://goproxy.cn,direct
# PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/
