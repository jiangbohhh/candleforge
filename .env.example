# CandleForge 环境变量模板
# 复制为 .env 后按需修改（.env 已被 .gitignore 忽略，不会提交）

# ── PostgreSQL ──
DB_HOST=postgres
DB_PORT=5432
DB_USER=candleforge
DB_PASSWORD=candleforge
DB_NAME=candleforge

# ── Go 主服务 ──
HTTP_ADDR=:8080
# Python 回测服务 gRPC 地址（compose 内用服务名 quant-py）
QUANT_ADDR=quant-py:50051

# ── Python 回测服务 ──
GRPC_ADDR=[::]:50051

# ── 前端 ──
# 前端访问后端的基址（浏览器侧，故用 localhost）
VITE_API_BASE=http://localhost:8080

# ── Binance API（M4 实盘才需要，先留空）──
# 配置 key/secret 即激活实盘交易；默认走 testnet (testnet.binance.vision)。
# testnet API key 从 https://testnet.binance.vision 申请；mainnet 需要二次确认。
BINANCE_API_KEY=
BINANCE_API_SECRET=

# 启用主网（真金白银）— 默认 false 走 testnet。
BINANCE_MAINNET=false
# 启用主网必须填这个字面量；任何其他值都会阻止启动。
BINANCE_MAINNET_CONFIRM=

# 可选：覆盖默认 endpoint（用镜像/proxy 时设置）。
# BINANCE_REST_BASE=
# BINANCE_WS_BASE=

# ── 网络代理（容器到 Binance 不通时使用）──
# 例如本地 Clash/V2Ray：HTTPS_PROXY=http://host.docker.internal:7890
# HTTPS_PROXY=
# HTTP_PROXY=

# ── 可选：构建期镜像源（网络受限时取消注释，加速容器内拉依赖）──
# NPM_REGISTRY=https://registry.npmmirror.com
# GOPROXY=https://goproxy.cn,direct
# PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/
